local function GetCharacterRoot()

	return CharacterRoot

end

local function GetRarityColor(Rarity)

	Rarity = string.lower(tostring(Rarity))


	if Rarity == "mythic" then

		return Color3.fromRGB(170,85,255)

	elseif Rarity == "legendary" then

		return Color3.fromRGB(255,170,0)

	elseif Rarity == "rare" then

		return Color3.fromRGB(85,170,0)

	elseif Rarity == "epic" then

		return Color3.fromRGB(0,85,255)

	elseif Rarity == "uncommon" then

		return Color3.fromRGB(100,68,40)

	elseif Rarity == "common" then

		return Color3.fromRGB(255,170,127)

	end


	return Color3.new(1,1,1)

end

local function CreateESP(Artifact)


	if ESPObjects[Artifact] then
		return
	end


	local Box = BoxTemplate:Clone()
	local Info = InfoTemplate:Clone()
	local Line = LineTemplate:Clone()
	
	Line.AnchorPoint = Vector2.new(0.5,0.5)


	Box.Parent = MainInterface
	Info.Parent = MainInterface
	Line.Parent = MainInterface



	local Holder = Info:WaitForChild("HolderF")


	local Data = {

		Box = Box,
		Info = Info,
		Line = Line,

		Artifact = Artifact,

		A = Holder.A,
		B = Holder.B,
		C = Holder.C,
		D = Holder.D,
		E = Holder.E

	}


	ESPObjects[Artifact] = Data



	Artifact.AncestryChanged:Connect(function(_,Parent)

		if not Parent then

			if ESPObjects[Artifact] then

				RemoveESP(Artifact)

			end

		end

	end)



local function Update()

	if not Artifact.Parent then
		RemoveESP(Artifact)
		return
	end

	local Root = GetCharacterRoot()
	if not Root then
		Box.Visible = false
		Info.Visible = false
		Line.Visible = false
		return
	end

	local WorldPos = Artifact.Position
	local ScreenPos, Visible = Camera:WorldToViewportPoint(WorldPos)

	if not Visible or ScreenPos.Z <= 0 then
		Box.Visible = false
		Info.Visible = false
		Line.Visible = false
		return
	end

	Box.Visible = true
	Info.Visible = true
	Line.Visible = true

	local Distance = (Root.Position - WorldPos).Magnitude

		local Scale = math.clamp(ScreenPos.Z / 400, 0.01, 0.045)

		Box.AnchorPoint = Vector2.new(0.5, 0.5)
		Box.Position = UDim2.fromOffset(ScreenPos.X, ScreenPos.Y)
		Box.Size = UDim2.new(Scale, 0, Scale, 0)

	Info.AnchorPoint = Vector2.new(0,0.5)
	local BoxPixels = Camera.ViewportSize.Y * Scale
	Info.Position = UDim2.fromOffset(
		ScreenPos.X + Box.AbsoluteSize.X/2 + 10,
		ScreenPos.Y
	)

	Info.Size = UDim2.fromOffset(
		BoxPixels * 3.5,
		BoxPixels * 2.8
	)

		local Start = ESPAnchor.AbsolutePosition + (ESPAnchor.AbsoluteSize * 0.5)
		Start -= MainInterface.AbsolutePosition
		
		local BoxPixels = Camera.ViewportSize.Y * Scale

		local End = Vector2.new(
			ScreenPos.X,
			ScreenPos.Y - BoxPixels * 0.35
		)

	local Delta = End - Start

	Line.AnchorPoint = Vector2.new(0.5,0.5)

	Line.Position = UDim2.fromOffset(
		(Start.X + End.X)/2,
		(Start.Y + End.Y)/2
	)

	Line.Size = UDim2.fromOffset(
		Delta.Magnitude,
		2
	)

	Line.Rotation = math.deg(
		math.atan2(
			Delta.Y,
			Delta.X
		)
	) -------

	local At = Artifact:GetAttribute("aType") or "Unknown"
	local Rarity = Artifact:GetAttribute("rarity") or "Unknown"
	local Mass = Artifact:GetAttribute("mass") or "?"
	local Depth = Artifact:GetAttribute("depth") or "?"

	Data.A.Text = At
	Data.B.Text = "Rarity: "..Rarity
	Data.B.TextColor3 = GetRarityColor(Rarity)
	Data.C.Text = "Mass: "..Mass
	Data.D.Text = "Depth: " .. string.format("%.2f", Depth) .. " Studs ↓"

	Data.E.Text = "Distance: "..math.floor(Distance).." Studs"

end



	Data.Update = Update



end

function RemoveESP(Artifact)


	local Data = ESPObjects[Artifact]


	if Data then

		Data.Box:Destroy()
		Data.Info:Destroy()
		Data.Line:Destroy()

		ESPObjects[Artifact]=nil

	end


end

local ScannedPlanets = {}


local function ScanPlanet(Planet)


	if ScannedPlanets[Planet] then
		return
	end


	ScannedPlanets[Planet] = true



	local Artifacts =
		Planet:FindFirstChild("Artifacts")


	if not Artifacts then
		return
	end



	for _,Artifact in ipairs(Artifacts:GetChildren()) do

		if Artifact:IsA("BasePart") then

			CreateESP(Artifact)

		end

	end



	Artifacts.ChildAdded:Connect(function(obj)

		if obj:IsA("BasePart") then

			CreateESP(obj)

		end

	end)



	Artifacts.ChildRemoved:Connect(function(obj)

		RemoveESP(obj)

	end)


end

local function CheckPlanets()


	local Root = GetCharacterRoot()

	if not Root then
		return
	end



	local Nearest
	local Shortest = math.huge



	for Planet,_ in pairs(Planets) do


		local Skin = Planet:FindFirstChild("Skin")


		if Skin then


			local Distance =
				(Root.Position - Skin.Position).Magnitude



			if Distance < Shortest then

				Shortest = Distance
				Nearest = Planet

			end

		end


	end



	if Shortest <= 100 then


		if CurrentPlanet ~= Nearest then


			ClearESP()


			CurrentPlanet = Nearest


			if CurrentPlanet then

				ScanPlanet(CurrentPlanet)

			end


		end


	else

		ClearESP()
		
		CurrentPlanet=nil


	end


end

