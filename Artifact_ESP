local function IsPlanet(Planet)

	if not Planet:IsA("Model") then
		return false
	end

	local Skin = Planet:FindFirstChild("Skin")
	local Artifacts = Planet:FindFirstChild("Artifacts")

	return Skin and Artifacts

end



for _,Planet in ipairs(PlanetsFolder:GetChildren()) do

	if IsPlanet(Planet) then
		Planets[Planet] = true
	end

end



PlanetsFolder.ChildAdded:Connect(function(Planet)

	task.wait()

	if IsPlanet(Planet) then
		Planets[Planet] = true
	end

end)


local function ClearESP()

	for Artifact, Data in pairs(ESPObjects) do
		Data.Box:Destroy()
		Data.Info:Destroy()
		Data.Line:Destroy()
		ESPObjects[Artifact] = nil
	end
	
	Count.Text = "Detected: 0"

	if CurrentPlanet then
		ScannedPlanets[CurrentPlanet] = nil
	end

end

PlanetsFolder.ChildRemoved:Connect(function(Planet)

	Planets[Planet] = nil


	if CurrentPlanet == Planet then

		ClearESP()
		CurrentPlanet = nil

	end

end)

