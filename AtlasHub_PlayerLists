function PlayerStatus.PrepareUI()

	local UI = UIParent:WaitForChild(UIName)

	PlayerStatus.UI = UI

	PlayerStatus.Main = UI:WaitForChild("Main")
	
	PlayerStatus.HolderF = PlayerStatus.Main:WaitForChild("HolderF")
	PlayerStatus.TemplateStorage = PlayerStatus.Main:WaitForChild("TemplateStorage")
	PlayerStatus.TopBar = PlayerStatus.Main:WaitForChild("TopBar")
	
	PlayerStatus.ScrollF = PlayerStatus.HolderF:WaitForChild("ScrollF") -- A Instance which store cloned frames
	
	PlayerStatus.Template = PlayerStatus.TemplateStorage:WaitForChild("Template") --- A Instance which will cone to ScrollF
	
	PlayerStatus.DragSizeBtn = PlayerStatus.Main:WaitForChild("DragSizeBtn") -- ingore this
	
	PlayerStatus.Main:SetAttribute("Draggable", true)
	PlayerStatus.Main:SetAttribute("CurrentSize",UDim2.new(0.55, 0, 0.55, 0))
	
	DragAPI:SetUp(PlayerStatus.Main, PlayerStatus.DragSizeBtn)
	
	PlayerStatus.InStudio = InStudioIcon -------- Image Asset
	PlayerStatus.StudioColor = InStudioColour ------ Color3 Value
	
	PlayerStatus.Online = OnlineIcon -------- Image Asset
	PlayerStatus.OnlineC = OnlineColour ------ Color3 Value
	
	PlayerStatus.Offline = OfflineIcon -------- Image Asset
	PlayerStatus.OfflineC = OfflineColour ------ Color3 Value
	
	PlayerStatus.InGame = InGameIcon -------- Image Asset
	PlayerStatus.InGameC = InGameColour ------ Color3 Value

end

local function GetRole(UserId)
	if TargetUserIds.Developers
		and TargetUserIds.Developers[UserId] then
		return "Developer"
	end

	if TargetUserIds.Moderators
		and TargetUserIds.Moderators[UserId] then
		return "Moderator"
	end

	if TargetUserIds.BetaTesters
		and TargetUserIds.BetaTesters[UserId] then
		return "Beta Tester"
	end

	if TargetUserIds.PossibleUsers
		and TargetUserIds.PossibleUsers[UserId] then
		return "Possible User"
	end

	return nil
end

local function GetTargetUsers()
	local Users = {}

	local function AddUsers(Category)
		if type(Category) ~= "table" then
			return
		end

		for UserId in pairs(Category) do
			UserId = tonumber(UserId)

			if UserId and not Users[UserId] then
				Users[UserId] = true
			end
		end
	end

	AddUsers(TargetUserIds.Developers)
	AddUsers(TargetUserIds.Moderators)
	AddUsers(TargetUserIds.BetaTesters)

	return Users
end

local function GetStatusData(Status)
	if Status == "Studio" then
		return "In Studio", PlayerStatus.InStudio, PlayerStatus.StudioColor
	elseif Status == "Game" then
		return "In Game", PlayerStatus.InGame, PlayerStatus.InGameC
	elseif Status == "Online" then
		return "Online", PlayerStatus.Online, PlayerStatus.OnlineC
	else
		return "Offline", PlayerStatus.Offline, PlayerStatus.OfflineC
	end
end

local function UpdateFrame(Frame, UserId)
	task.spawn(function()
		local Username, DisplayName, Status, Thumbnail =
			GetPlayerStatus(UserId)

		if not Frame or not Frame.Parent then
			return
		end

		local Role = GetRole(UserId)

		local StatusText, StatusIcon, StatusColor =
			GetStatusData(Status)

		Frame.Name = "Player_" .. tostring(UserId)
		Frame.Visible = true

		local StatusF = Frame:FindFirstChild("StatusF")

		if StatusF then
			local StatusIconObject = StatusF:FindFirstChild("AStatusIcon")
			local StatusTextObject = StatusF:FindFirstChild("BStatus")

			if StatusIconObject then
				StatusIconObject.Image = StatusIcon
				StatusIconObject.ImageColor3 = StatusColor
			end

			if StatusTextObject then
				StatusTextObject.Text = StatusText
			end
		end

		local StatusStroke = Frame:FindFirstChild("StatusStroke")

		if StatusStroke and StatusStroke:IsA("UIStroke") then
			StatusStroke.Color = StatusColor
		end

		local PlayerImage = Frame:FindFirstChild("PlayerImage")

		if PlayerImage then
			local Icon = PlayerImage:FindFirstChild("Icon")

			if Icon and Thumbnail then
				Icon.Image = Thumbnail
			end

			local ImageStroke = PlayerImage:FindFirstChild("StatusStroke")

			if ImageStroke and ImageStroke:IsA("UIStroke") then
				ImageStroke.Color = StatusColor
			end
		end

		local InfoF = Frame:FindFirstChild("InfoF")

		if InfoF then
			local DisplayT = InfoF:FindFirstChild("DisplayT")
			local UserT = InfoF:FindFirstChild("UserT")
			local IdT = InfoF:FindFirstChild("IdT")

			if DisplayT then
				local DisplayRole = Role

				if Role == "Possible User" then
					DisplayRole = "Suspended User"
				end

				if DisplayRole then
					DisplayT.Text =
						DisplayName .. " [" .. DisplayRole .. "]"
				else
					DisplayT.Text = DisplayName
				end
			end

			if UserT then
				UserT.Text = "@" .. Username
			end

			if IdT then
				IdT.Text = "UID: " .. tostring(UserId)
			end
		end
	end)
end

local function CreatePlayerFrame(UserId)
	if PlayerFrames[UserId] then
		return PlayerFrames[UserId]
	end

	local Frame =
		PlayerStatus.Template:Clone()

	Frame.Name = "Player_" .. tostring(UserId)
	Frame.Visible = true
	Frame.Parent = PlayerStatus.ScrollF

	PlayerFrames[UserId] = Frame

	return Frame
end

local function RemoveMissingPlayers(TargetUsers)
	for UserId, Frame in pairs(PlayerFrames) do
		if not TargetUsers[UserId] then
			if Frame and Frame.Parent then
				Frame:Destroy()
			end

			PlayerFrames[UserId] = nil
		end
	end
end

function PlayerStatus.Refresh()
	if not PlayerStatus.ScrollF
		or not PlayerStatus.Template then
		return
	end

	local TargetUsers = GetTargetUsers()

	RemoveMissingPlayers(TargetUsers)

	for UserId in pairs(TargetUsers) do
		if not (
			TargetUserIds.PossibleUsers
				and TargetUserIds.PossibleUsers[UserId]
			) then

			local Frame = PlayerFrames[UserId]

			if not Frame then
				Frame = CreatePlayerFrame(UserId)
			end

			UpdateFrame(Frame, UserId)

			task.wait(PlayerDelay)
		end
	end
end

function PlayerStatus.Init()

warn("Started eeeeeeee")

	PlayerStatus.CreateUI()
	PlayerStatus.PrepareUI()

	if Refreshing then
		return
	end

	Refreshing = true

	task.spawn(function()

		PlayerStatus.Refresh()

		FirstLoad = false

		while Refreshing do
			task.wait(RefreshTime)

			if not Refreshing then
				break
			end

			PlayerStatus.Refresh()
		end

	end)
end
 
function PlayerStatus.Stop()
	Refreshing = false
end

return PlayerStatus
