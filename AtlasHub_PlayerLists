local function executorRequest(Request)
	if not http then
		return nil
	end

	local Success, Response = pcall(http, Request)

	if not Success then
		return nil
	end

	return Response
end

local function GetPlayerStatus(UserId)
	UserId = tonumber(UserId)

	if not UserId then
		return "Unknown", "Unknown", "Offline", nil
	end

	local Username = "Unknown"
	local DisplayName = "Unknown"
	local Status = "Offline"
	local Thumbnail = nil

	local UserResponse = executorRequest({
		Url = "https://users.roblox.com/v1/users/" .. tostring(UserId),
		Method = "GET"
	})

	if UserResponse then
		local Body = UserResponse.Body
			or UserResponse.ResponseBody
			or UserResponse.body

		if Body then
			local Success, UserData = pcall(function()
				return HttpService:JSONDecode(Body)
			end)

			if Success and type(UserData) == "table" then
				Username = UserData.name or "Unknown"
				DisplayName = UserData.displayName or "Unknown"
			end
		end
	end

	local PresenceResponse = executorRequest({
		Url = "https://presence.roblox.com/v1/presence/users",
		Method = "POST",

		Headers = {
			["Content-Type"] = "application/json"
		},

		Body = HttpService:JSONEncode({
			userIds = {UserId}
		})
	})

	if PresenceResponse then
		local Body = PresenceResponse.Body
			or PresenceResponse.ResponseBody
			or PresenceResponse.body

		if Body then
			local Success, Data = pcall(function()
				return HttpService:JSONDecode(Body)
			end)

			if Success and type(Data) == "table" then
				local Presence = Data.userPresences
					and Data.userPresences[1]

				if Presence then
					local PresenceType = Presence.userPresenceType

					if PresenceType == 0 then
						Status = "Offline"
					elseif PresenceType == 1 then
						Status = "Online"
					elseif PresenceType == 2 then
						Status = "Game"
					elseif PresenceType == 3 then
						Status = "Studio"
					end
				end
			end
		end
	end

	local ThumbnailResponse = executorRequest({
		Url =
			"https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds="
			.. tostring(UserId)
			.. "&size=150x150&format=Png&isCircular=false",

		Method = "GET"
	})

	if ThumbnailResponse then
		local Body = ThumbnailResponse.Body
			or ThumbnailResponse.ResponseBody
			or ThumbnailResponse.body

		if Body then
			local Success, Data = pcall(function()
				return HttpService:JSONDecode(Body)
			end)

			if Success and Data.data and Data.data[1] then
				Thumbnail = Data.data[1].imageUrl
			end
		end
	end

	return Username, DisplayName, Status, Thumbnail
end

