function AtlasHub_SystemNoti:ResetDetection()

	self.DetectedPlayers = {
		Developers = {},
		Moderators = {},
		BetaTesters = {},
		PossibleUsers = {},
		VIPs = {},
	}
end

local function IsInTable(Table, UserId)

	if not Table then
		return false
	end

	return Table[UserId] == true
end

function AtlasHub_SystemNoti:GetPlayerRank(Player)

	if not Player then
		return nil
	end

	local UserId = Player.UserId

	if IsInTable(TargetedUserIds.Developers, UserId) then
		return "Developers"
	end

	if IsInTable(TargetedUserIds.Moderators, UserId) then
		return "Moderators"
	end

	if IsInTable(TargetedUserIds.BetaTesters, UserId) then
		return "BetaTesters"
	end

	if IsInTable(TargetedUserIds.PossibleUsers, UserId) then
		return "PossibleUsers"
	end

	if Player:GetAttribute("vip") == true then
		return "VIPs"
	end

	return nil
end

function AtlasHub_SystemNoti:AddDetectedPlayer(Player)

	local Rank = self:GetPlayerRank(Player)

	if not Rank then
		return false
	end

	local List = self.DetectedPlayers[Rank]

	if not List then
		return false
	end

	for _, ExistingPlayer in ipairs(List) do
		if ExistingPlayer == Player then
			return true
		end
	end

	table.insert(List, Player)

	return true
end

function AtlasHub_SystemNoti:RemoveDetectedPlayer(Player)

	for Category, List in pairs(self.DetectedPlayers) do

		for Index = #List, 1, -1 do

			if List[Index] == Player then
				table.remove(List, Index)
			end

		end
	end
end

function AtlasHub_SystemNoti:GetDetectionCounts()

	return {
		Developers = #self.DetectedPlayers.Developers,
		Moderators = #self.DetectedPlayers.Moderators,
		BetaTesters = #self.DetectedPlayers.BetaTesters,
		PossibleUsers = #self.DetectedPlayers.PossibleUsers,
		VIPs = #self.DetectedPlayers.VIPs,
	}
end

local function FormatCategory(Name, Count)

	if Count <= 0 then
		return nil
	end

	local SingularNames = {
		Developers = "Developer",
		Moderators = "Moderator",
		BetaTesters = "Beta Tester",
		PossibleUsers = "Possible User",
		VIPs = "VIP",
	}

	local PluralNames = {
		Developers = "Developers",
		Moderators = "Moderators",
		BetaTesters = "Beta Testers",
		PossibleUsers = "Possible Users",
		VIPs = "VIPs",
	}

	if Count == 1 then
		return "1 " .. SingularNames[Name]
	end

	return tostring(Count) .. " " .. PluralNames[Name]
end

function AtlasHub_SystemNoti:BuildDetectionMessage()

	local Counts = self:GetDetectionCounts()

	local Parts = {}

	local Order = {
		"Developers",
		"Moderators",
		"BetaTesters",
		"PossibleUsers",
		"VIPs",
	}

	for _, Category in ipairs(Order) do

		local Text = FormatCategory(
			Category,
			Counts[Category]
		)

		if Text then
			table.insert(Parts, Text)
		end
	end

	if #Parts == 0 then
		return nil
	end

	if #Parts == 1 then

		return "We've detected that a "
			.. Parts[1]
			.. " is in this server. Please choose an option below"
	end

	local Combined = ""

	for Index, Text in ipairs(Parts) do

		if Index == 1 then
			Combined = Text

		elseif Index == #Parts then
			Combined = Combined .. " and " .. Text

		else
			Combined = Combined .. ", " .. Text
		end
	end

	return "We've detected that "
		.. Combined
		.. " are in this game. Please choose an option below"
end

function AtlasHub_SystemNoti:PlaySound(Sound)

	if not Sound then
		return
	end

	Sound.TimePosition = 0
	Sound:Play()
end

function AtlasHub_SystemNoti:ShowNotification()

	if self.AutoTPEnabled then
		return
	end

	local Message = self:BuildDetectionMessage()

	if not Message then
		return
	end

	self.DescBox.Text = Message

	if self.IsShowing then

		self:PlaySound(self.NotiSFX)

		return
	end

	self.IsShowing = true

	self.Main.Visible = true

	self.UIScale.Scale = 0

	self:PlaySound(self.NotiSFX)

	self:PlaySound(self.OpenSFX)

	local Tween = TweenService:Create(
		self.UIScale,
		TweenInfo.new(
			0.35,
			Enum.EasingStyle.Quart,
			Enum.EasingDirection.Out
		),
		{
			Scale = 1
		}
	)

	Tween:Play()
end

function AtlasHub_SystemNoti:HideNotification(PlayCloseSound)

	if not self.IsShowing then
		return
	end

	self.IsShowing = false

	if PlayCloseSound then
		self:PlaySound(self.CloseSFX)
	end

	self.Main.Visible = false
	self.UIScale.Scale = 0
end

function AtlasHub_SystemNoti:ScanPlayers()

	if self.AutoTPEnabled then
		return
	end

	self:ResetDetection()

	for _, Player in ipairs(Players:GetPlayers()) do

		if self.AutoTPEnabled then
			return
		end

		self:AddDetectedPlayer(Player)
	end

	local Message = self:BuildDetectionMessage()

	if Message then
		self:ShowNotification()
	end
end

function AtlasHub_SystemNoti:CheckPlayer(Player)

	if self.AutoTPEnabled then
		return
	end

	if not Player then
		return
	end

	task.wait(2)

	if self.AutoTPEnabled then
		return
	end

	if not Player.Parent then
		return
	end

	self:ScanPlayers()
end

function AtlasHub_SystemNoti:HandlePlayerRemoving(Player)

	self:RemoveDetectedPlayer(Player)

	if self.AutoTPEnabled then
		return
	end

	self:ScanPlayers()
end

function AtlasHub_SystemNoti:ServerHop()

	TeleportService:Teleport(game.PlaceId)
end

function AtlasHub_SystemNoti:SetupButtons()

	self.SAS.MouseButton1Click:Connect(function()
		self:PlaySound(self.ClickSFX)

		self.AutoTPEnabled = true

		self:HideNotification(true)

		warn(
			"[AtlasHub System Notification] "
				.. "AutoTPEnabled has been enabled. "
				.. "Further notifications are disabled."
		)

	end)

	self.TTR.MouseButton1Click:Connect(function()

		self:PlaySound(self.ClickSFX)

		self:HideNotification(true)

	end)

	self.SS.MouseButton1Click:Connect(function()

		self:PlaySound(self.ClickSFX)

		self:HideNotification(true)

		task.defer(function()
			self:ServerHop()
		end)

	end)
end

function AtlasHub_SystemNoti:StartPlayerMonitoring()

	if self.PlayerAddedConnection then
		self.PlayerAddedConnection:Disconnect()
		self.PlayerAddedConnection = nil
	end

	self.PlayerAddedConnection =
		Players.PlayerAdded:Connect(function(Player)

			task.spawn(function()

				if self.AutoTPEnabled then
					return
				end

				self:CheckPlayer(Player)

			end)

		end)

	Players.PlayerRemoving:Connect(function(Player)

		if self.AutoTPEnabled then
			return
		end

		self:HandlePlayerRemoving(Player)

	end)
end

function AtlasHub_SystemNoti:Start()

	if self.Started then
		return
	end

	self.Started = true

	self:PrepareUI()
	self:CreateSounds()
	self:SetupButtons()
	self:StartPlayerMonitoring()
	task.wait(2)

	if self.AutoTPEnabled then
		return
	end
	
	self:ScanPlayers()
end

return AtlasHub_SystemNoti
