local function ShowNotify(txt, dur)
	dur = dur or 3

	if CurrentNotify then
		CurrentNotify:Destroy()
		CurrentNotify = nil
	end

	local Noti = NotifyTemplate:Clone()
	Noti.Parent = NotificationBar
	CurrentNotify = Noti

	local NotiText = Noti:WaitForChild("NotiText")

	NotiText.Text = txt
	
	local OriginalPos = Noti.Position

	Noti.Position = UDim2.new(
		OriginalPos.X.Scale,
		OriginalPos.X.Offset,
		-1,
		OriginalPos.Y.Offset
	)

	local ShowTween = TweenService:Create(
		Noti,
		TweenInfo.new(
			0.35,
			Enum.EasingStyle.Quart,
			Enum.EasingDirection.Out
		),
		{
			Position = OriginalPos
		}
	)

	ShowTween:Play()
	ShowTween.Completed:Wait()

	NotifSFX.TimePosition = 0
	NotifSFX:Play()

	task.wait(dur)

	local HideTween = TweenService:Create(
		Noti,
		TweenInfo.new(
			0.35,
			Enum.EasingStyle.Quart,
			Enum.EasingDirection.In
		),
		{
			Position = UDim2.new(
				OriginalPos.X.Scale,
				OriginalPos.X.Offset,
				-1,
				OriginalPos.Y.Offset
			)
		}
	)

	HideTween:Play()
	HideTween.Completed:Wait()

	if CurrentNotify == Noti then
		CurrentNotify = nil
	end

	Noti:Destroy()
end

