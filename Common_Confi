local Config = {}

function SafeRequire(Module)
	if not Module or not Module:IsA("ModuleScript") then
		warn("Invalid module")
		return nil, "Invalid module"
	end

	local Success, Result = pcall(function()
		return require(Module)
	end)

	if Success then
		return Result, nil
	end

	warn("Cannot require module:", Result)
	return nil, Result
end

local CommonModule, CommonError = SafeRequire(game.ReplicatedStorage.RModules.CommonModule)

function Config.SetDebrisPlotter(Value)

	if not CommonModule then
		return false, "Your Executor deos not support this feature!"
	end

	local DebrisPlotter = CommonModule.ModuleTypes["Debris plotter"]

	if not DebrisPlotter then
		warn("Debris Plotter module not found.")
		return false, "Debris Plotter module not found."
	end


	if Value then
		if not getgenv().OldDebrisPlotterLevels then
			getgenv().OldDebrisPlotterLevels = table.clone(DebrisPlotter.bonusLevels)
		end

		DebrisPlotter.bonusLevels = {
			100000,
			100000,
			100000,
			100000
		}

		return true, "No Debris Plotter Limits Enabled"
	else
		if getgenv().OldDebrisPlotterLevels then
			DebrisPlotter.bonusLevels = table.clone(getgenv().OldDebrisPlotterLevels)
		else
			DebrisPlotter.bonusLevels = {
				5,
				10,
				15,
				20
			}
		end

		return true, "No Debris Plotter Limits Disabled"
	end
end

function Config.DestoryShip()
	local RocketEvent = game:GetService("ReplicatedStorage")
		:WaitForChild("Events")
		:WaitForChild("RocketEvent")

	RocketEvent:FireServer(
		"crash",
		{
			touchSpeed = 1000
		}
	)
end

function Config.SetShipSpeed(plr, value)
	local char = plr.Character
	local hum = char:WaitForChild("Humanoid")

	local SeatPart = hum.SeatPart
	if not SeatPart then return end

	local ship = SeatPart.Parent

	local Main = ship.Main
	if not Main then return end
	local speed = Main:GetAttribute("maxSpeed")
	if speed then
		Main:SetAttribute("maxSpeed", value)
	end
end

