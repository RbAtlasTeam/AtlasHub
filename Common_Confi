local Config = {}

local CommonModule = require(game.ReplicatedStorage.RModules.CommonModule)

function Config.SetDebrisPlotter(Value)
	local DebrisPlotter = CommonModule.ModuleTypes["Debris plotter"]

	if not DebrisPlotter then
		warn("Debris Plotter module not found.")
		return
	end

	if Value then
		if not getgenv().OldDebrisPlotterLevels then
			getgenv().OldDebrisPlotterLevels = table.clone(DebrisPlotter.bonusLevels)
		end

		DebrisPlotter.bonusLevels = {
			100000,
			100000,
			100000,
			100000
		}
	else
		if getgenv().OldDebrisPlotterLevels then
			DebrisPlotter.bonusLevels = table.clone(getgenv().OldDebrisPlotterLevels)
			print("Debris Plotter bonus restored.")
		else
			DebrisPlotter.bonusLevels = {
				5,
				10,
				15,
				20
			}
		end
	end
end

function Config.DestoryShip()
	local RocketEvent = game:GetService("ReplicatedStorage")
		:WaitForChild("Events")
		:WaitForChild("RocketEvent")

	RocketEvent:FireServer(
		"crash",
		{
			touchSpeed = 1000
		}
	)
end

local function GetShipMain(plr)
	if not plr or not plr.Character then
		return nil, "Failed to apply: character not found!"
	end

	local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil, "Failed to apply: humanoid not foun!."
	end

	local seat = humanoid.SeatPart
	if not seat then
		return nil, "Failed to apply: not sitting in ship!"
	end

	if seat.Name ~= "DriverSeat" or not seat:GetAttribute("rocketSeat") then
		return nil, "Failed to apply: not sitting in a rocket!"
	end

	local ship = seat.Parent
	if not ship then
		return nil, "Failed to apply: ship not found!."
	end

	local main = ship:FindFirstChild("Main")
	if not main then
		return nil, "Failed to apply: Game Error!."
	end

	return main
end

function Config.SetShipSpeed(plr, value)
	local main, err = GetShipMain(plr)
	if not main then
		return false, err
	end

	main:SetAttribute("maxSpeed", value)

	return true, "Successfully applied max speed."
end

