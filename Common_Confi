local Config = {}

local CommonModule = require(game.ReplicatedStorage.RModules.CommonModule)

function Config.SetDebrisPlotter(Value)
	local DebrisPlotter = CommonModule.ModuleTypes["Debris plotter"]

	if not DebrisPlotter then
		warn("Debris Plotter module not found.")
		return
	end

	if Value then
		if not getgenv().OldDebrisPlotterLevels then
			getgenv().OldDebrisPlotterLevels = table.clone(DebrisPlotter.bonusLevels)
		end

		DebrisPlotter.bonusLevels = {
			100000,
			100000,
			100000,
			100000
		}
	else
		if getgenv().OldDebrisPlotterLevels then
			DebrisPlotter.bonusLevels = table.clone(getgenv().OldDebrisPlotterLevels)
			print("Debris Plotter bonus restored.")
		else
			DebrisPlotter.bonusLevels = {
				5,
				10,
				15,
				20
			}
		end
	end
end

function Config.DestoryShip()
	local RocketEvent = game:GetService("ReplicatedStorage")
		:WaitForChild("Events")
		:WaitForChild("RocketEvent")

	RocketEvent:FireServer(
		"crash",
		{
			touchSpeed = 1000
		}
	)
end

local function GetShipMain(plr)
	local character = plr.Character
	if not character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end

	local seat = humanoid.SeatPart
	if not seat then return end

	if not seat:GetAttribute("rocketSeat") then return end

	return seat.Parent:FindFirstChild("Main")
end

function Config.SetShipSpeed(plr, value)
	local main = GetShipMain(plr)
	if not main then return end

	main:SetAttribute("maxSpeed", value)
end

function Config.SetShipAcceleration(plr, value)
	local main = GetShipMain(plr)
	if not main then return end

	main:SetAttribute("acceleration", value)
end

function Config.SetShipDeceleration(plr, value)
	local main = GetShipMain(plr)
	if not main then return end

	main:SetAttribute("deceleration", value)
end

function Config.SetShipAgility(plr, value)
	local main = GetShipMain(plr)
	if not main then return end

	main:SetAttribute("agility", value)
end


return Config
