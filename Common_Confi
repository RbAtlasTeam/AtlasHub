local Config = {}

local CommonModule = require(game.ReplicatedStorage.RModules.CommonModule)

function Config.SetDebrisPlotter(Value)
	local DebrisPlotter = CommonModule.ModuleTypes["Debris plotter"]

	if not DebrisPlotter then
		warn("Debris Plotter module not found.")
		return
	end

	if Value then
		if not getgenv().OldDebrisPlotterLevels then
			getgenv().OldDebrisPlotterLevels = table.clone(DebrisPlotter.bonusLevels)
		end

		DebrisPlotter.bonusLevels = {
			100000,
			100000,
			100000,
			100000
		}
	else
		if getgenv().OldDebrisPlotterLevels then
			DebrisPlotter.bonusLevels = table.clone(getgenv().OldDebrisPlotterLevels)
			print("Debris Plotter bonus restored.")
		else
			DebrisPlotter.bonusLevels = {
				5,
				10,
				15,
				20
			}
		end
	end
end

function Config.DestoryShip()
	local RocketEvent = game:GetService("ReplicatedStorage")
		:WaitForChild("Events")
		:WaitForChild("RocketEvent")

	RocketEvent:FireServer(
		"crash",
		{
			touchSpeed = 1000
		}
	)
end

function Config.SetShipSpeed(plr, value)
	local char = plr.Character
	local hum = char:WaitForChild("Humanoid")
	
	local SeatPart = hum.SeatPart
	if not SeatPart then return end
	
	local ship = SeatPart.Parent
	
	local Main = ship.Main
	if not Main then return end
	
	Main:SetAttribute("maxSpeed", value)
end

