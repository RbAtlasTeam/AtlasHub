local function CreateESP(Object, PositionPart, ObjectType)


	if ESPObjects[Object] then
		return
	end

	if not PositionPart then

		if Object:IsA("Model") then
			PositionPart = Object:FindFirstChild("Skin")
		else
			PositionPart = Object
		end
	end

	if Object.Name == "Red Keycard" or Object.Name == "Blue Keycard" then

		local HP = Object:GetAttribute("hitpoints")

		if HP and HP <= 0 then
			RemoveESP(Object)
			return
		end

	end


	if not PositionPart then
		return
	end

	local Box = BoxTemplate:Clone()
	local Info = InfoTemplate:Clone()
	local Line = LineTemplate:Clone()

	Line.AnchorPoint = Vector2.new(0.5,0.5)


	Box.Parent = MainInterface
	Info.Parent = MainInterface
	Line.Parent = MainInterface

	local Holder = Info:WaitForChild("HolderF")


	local Data = {

		Box = Box,
		Info = Info,
		Line = Line,

		Object = Object,
		PositionPart = PositionPart,

		ObjectType = ObjectType or "Normal",

		A = Holder.A,
		B = Holder.B,
		C = Holder.C,

	}


	ESPObjects[Object] = Data



	Object.AncestryChanged:Connect(function(_,Parent)

		if not Parent then

			if ESPObjects[Object] then
				RemoveESP(Object)
			end

		end

	end)

	local function Update()

		if not Object:IsDescendantOf(game) then
			RemoveESP(Object)
			return
		end
			
		if Object.Name == "Red Keycard" or Object.Name == "Blue Keycard" then

				local HP = Object:GetAttribute("hitpoints")

				if HP and HP <= 0 then

					RemoveESP(Object)
					return

				end

			end

		if not PositionPart.Parent then
			RemoveESP(Object)
			return
		end

		local Root = GetCharacterRoot()
		if not Root then
			Box.Visible = false
			Info.Visible = false
			Line.Visible = false
			return
		end

		local WorldPos = PositionPart.Position
		local ScreenPos, Visible = Camera:WorldToViewportPoint(WorldPos)

		if not Visible or ScreenPos.Z <= 0 then
			Box.Visible = false
			Info.Visible = false
			Line.Visible = false
			return
		end

		Box.Visible = BoxesValue.Value
		Info.Visible = InfoValue.Value
		Line.Visible = LinesValue.Value

		local Distance = (Root.Position - WorldPos).Magnitude

		Data.A.Text = Object.Name


		Data.B.Text =
			string.format(
				"Distance: %.0f Studs",
				Distance
			)

		if Data.ObjectType == "Voyager" then

			local Minerals = Object:FindFirstChild("Minerals")
			local Record = Minerals and Minerals:FindFirstChild("Golden Record")

			local HasRecord = false

			if Record then

				local HP = Record:GetAttribute("hitpoints")

				if HP and HP > 0 then
					HasRecord = true
				end

			end


			Data.C.Text =
				"Golden Record: "..tostring(HasRecord)


			if HasRecord then
				Line.BackgroundColor3 = Color3.fromRGB(255,215,0)
			else
				Line.BackgroundColor3 = Color3.fromRGB(255,0,0)
			end


		else

			Data.C.Text =
				string.format(
					"Pos: %.0f, %.0f, %.0f",
					WorldPos.X,
					WorldPos.Y,
					WorldPos.Z
				)

		end


		local Scale = math.clamp(ScreenPos.Z / 400, 0.01, 0.045)

		Box.AnchorPoint = Vector2.new(0.5, 0.5)
		Box.Position = UDim2.fromOffset(ScreenPos.X, ScreenPos.Y)
		Box.Size = UDim2.new(Scale, 0, Scale, 0)

		Info.AnchorPoint = Vector2.new(0,0.5)
		local BoxPixels = Camera.ViewportSize.Y * Scale
		Info.Position = UDim2.fromOffset(
			ScreenPos.X + Box.AbsoluteSize.X/2 + 10,
			ScreenPos.Y
		)

		Info.Size = UDim2.fromOffset(
			BoxPixels * 3.5,
			BoxPixels * 2.8
		)

		local Start = ESPAnchor.AbsolutePosition + (ESPAnchor.AbsoluteSize * 0.5)
		Start -= MainInterface.AbsolutePosition

		local BoxPixels = Camera.ViewportSize.Y * Scale

		local End = Vector2.new(
			ScreenPos.X,
			ScreenPos.Y - BoxPixels * 0.35
		)

		local Delta = End - Start

		Line.AnchorPoint = Vector2.new(0.5,0.5)

		Line.Position = UDim2.fromOffset(
			(Start.X + End.X)/2,
			(Start.Y + End.Y)/2
		)

		Line.Size = UDim2.fromOffset(
			Delta.Magnitude,
			2
		)

		Line.Rotation = math.deg(
			math.atan2(
				Delta.Y,
				Delta.X
			)
		) -------

	end



	Data.Update = Update



end

function RemoveESP(Artifact)


	local Data = ESPObjects[Artifact]


	if Data then

		Data.Box:Destroy()
		Data.Info:Destroy()
		Data.Line:Destroy()

		ESPObjects[Artifact]=nil

	end
end

local function CheckHiddenObjects()

	local Planetoids = Workspace:FindFirstChild("Planetoids")

	if Planetoids then

		local Voyager = Planetoids:FindFirstChild("Voyager")

		if Voyager then
			CreateESP(
				Voyager,
				Voyager:FindFirstChild("Skin"),
				"Voyager"
			)
		end

	end

	local Planets = Workspace:FindFirstChild("Planets")

	if Planets then

		local PlanetX = Planets:FindFirstChild("Planet X")

		if PlanetX then

			CreateESP(
				PlanetX,
				PlanetX:FindFirstChild("Skin"),
				"Normal"
			)
		end

	end


	local Other = Workspace:FindFirstChild("Other")

	if Other then

		local Minerals = Other:FindFirstChild("Minerals")

		if Minerals then

			local Prism = Minerals:FindFirstChild("Shepherd Prism")

			if Prism then

				CreateESP(
					Prism,
					Prism,
					"Normal"
				)

			end

		end

	end	
end

Workspace.DescendantAdded:Connect(function(Object)

	if Object.Name == "Red Keycard"
		or Object.Name == "Blue Keycard" then

		local HP = Object:GetAttribute("hitpoints")

		if not HP or HP > 0 then

			CreateESP(
				Object,
				Object,
				"Normal"
			)

		end

	end
	
	Object:GetAttributeChangedSignal("hitpoints"):Connect(function()

		local HP = Object:GetAttribute("hitpoints")

		if HP and HP > 0 then

			CreateESP(
				Object,
				Object,
				"Normal"
			)

		else

			RemoveESP(Object)

		end

	end)

end)

local function ValidateESPObjects()

	for Object, Data in pairs(ESPObjects) do
		if not Object:IsDescendantOf(game) then

			RemoveESP(Object)
			continue

		end


		if Object.Name == "Red Keycard" or Object.Name == "Blue Keycard" then

			local HP = Object:GetAttribute("hitpoints")

			if HP and HP <= 0 then
				RemoveESP(Object)
			end
		end
	end

end

RunService.RenderStepped:Connect(function()

	CheckHiddenObjects()

	for _,Data in pairs(ESPObjects) do


		if Data.Update then

			Data.Update()

		end


	end


	local CountObjects = 0

	for _ in pairs(ESPObjects) do
		CountObjects += 1
	end

	Count.Text = "Total Objects: "..CountObjects


end)

