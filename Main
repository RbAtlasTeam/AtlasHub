local AtlasHub = loadstring(game:HttpGet("https://raw.githubusercontent.com/RbAtlasTeam/AtlasHub/refs/heads/main/UILibrary"))()

local Players = game:GetService("Players")
local TCS = game:GetService("TextChatService")
local TeleportService = game:GetService("TeleportService")

local LocalPlayer = Players.LocalPlayer

local CurrentPlace = game.PlaceId

AtlasHub:StartLibrary()

local AtlasHub_Datas = game.CoreGui:WaitForChild("AtlasHub_Datas")

local AtlasHub_ValueDatas = Instance.new("Folder")
AtlasHub_ValueDatas.Name = "AtlasHub_ValuesDatas"
AtlasHub_ValueDatas.Parent = AtlasHub_Datas

local function ShowNotify(Text, Duration)
	AtlasHub:Notify(Text, Duration)
end

AtlasHub:Notify(
	"Loading Atlas Hub for The Space Simulator",
	3
)

----- Call LoadStrings -----

loadstring(game:HttpGet("https://raw.githubusercontent.com/RbAtlasTeam/AtlasHub/refs/heads/main/Ship%2C%20Mine%20and%20Inventory%20AtlasHub"))()

local MineAndInventory = loadstring(game:HttpGet("https://raw.githubusercontent.com/RbAtlasTeam/AtlasHub/refs/heads/main/MineAndInventory_Module"))()
local DrillConfi = loadstring(game:HttpGet("https://raw.githubusercontent.com/RbAtlasTeam/AtlasHub/refs/heads/main/Drill_Configurations"))()

------------------------------------------------------

local OldInventoryV = AtlasHub_ValueDatas:WaitForChild("OldInventory")
local OneHitResourcesV = AtlasHub_ValueDatas:WaitForChild("OneHitResources")
local AlwaysEquipParachuteV = AtlasHub_ValueDatas:WaitForChild("AlwaysEquipParachute")
local ShipNoClipV = AtlasHub_ValueDatas:WaitForChild("ShipNoClip")
local CollectAllLocalPlanetGemValue = AtlasHub_ValueDatas:WaitForChild("CollectAllLocalPlanetGemValue")
local CollectAllLocalPlanetArtifactValue = AtlasHub_ValueDatas:WaitForChild("CollectAllLocalPlanetArtifactValue")

-------------------------------------------------------------------------------------------------------------------------

local ShipTab = AtlasHub:CreateTab("Ship","Ship Tab","rbxassetid://16149155528")
local PlayerTab = AtlasHub:CreateTab("Player", "Player Tab","rbxassetid://117259180607823")
local MineAndInventoryTab = AtlasHub:CreateTab("Inventory", "Mine and Inventory", "rbxassetid://120575375806036")
local DrillTab = AtlasHub:CreateTab("Drill", "Drill Tab", "rbxassetid://11959189471")


---- Player Tab ------------------------------------------------------------------------------

local Walkspeed = AtlasHub.TextBox:Create(PlayerTab, "Walkspeed", "Enter Walkspeed amount...")
local JumpPower = AtlasHub.TextBox:Create(PlayerTab, "JumpPower", "Enter JumpPower amount...")
local HipHeight = AtlasHub.TextBox:Create(PlayerTab, "HipHeight", "Enter HipHeight amount...")
local CameraMaxZoom = AtlasHub.TextBox:Create(PlayerTab, "CameraMaxZoom", "Enter CameraMaxZoom amount...")
local JetpackSpeed = AtlasHub.TextBox:Create(PlayerTab, "JetpackSpeed", "Enter JetpackSpeed amount...")
local RejoinBtn = AtlasHub.Button:Create(PlayerTab,"Rejoin Server")

--- TextBox Functions -------------------------------

Walkspeed.Submitted:Connect(function(Text)
	local v = tonumber(Text) or 0
	if not v or v < 1 then ShowNotify("Value must be at least 1, resetting WalkSpeed...", 3); v = 18 end
	game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = v
end)

JumpPower.Submitted:Connect(function(Text)
	local v = tonumber(Text) or 0
	if not v or v < 1 then ShowNotify("Value must be at least 1, resetting JumpPower...", 3); v = 28 end
	game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid").JumpPower = v
end)

HipHeight.Submitted:Connect(function(Text)
	local v = tonumber(Text) or 0
	if not v or v < 1 then ShowNotify("Value must be at least 1, resetting HipHeight...", 3); v = 2 end
	game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid").HipHeight = v
end)

JetpackSpeed.Submitted:Connect(function(Text)
	local v = tonumber(Text) or 0
	if not v or v < 1 then ShowNotify("Value must be at least 1, resetting JetpackSpeed...", 3); v = 8 end
	game.Players.LocalPlayer:SetAttribute("jetpackSpeed", v)
end)

CameraMaxZoom.Submitted:Connect(function(Text)
	local v = tonumber(Text) or 0
	if not v or v < 1 then ShowNotify("Value must be at least 1, resetting CameraMaxZoom...", 3); v = 40 end
	LocalPlayer.CameraMaxZoomDistance = v
end)


RejoinBtn.Clicked:Connect(function()
	ShowNotify("Teleporting to same server...", 4)
	wait(1)
	TeleportService:Teleport(CurrentPlace, LocalPlayer)
end)

------------------------------------------------------------------------------------------------------------------------------------------------------------

---- Ship Tab ------------------------------------------------------------------------------

local ShipNoClip = AtlasHub.Toggle:Create(ShipTab, "ShipNoClip", "Fly the ship through walls")


ShipNoClip.Changed:Connect(function(Value)
	ShipNoClipV.Value = Value
end)


------------------------------------------------------------------------------------------------------------------------------------------------------------

---- Mine and Inventory Tab ------------------------------------------------------------------------------

local OneHitResources = AtlasHub.Toggle:Create(MineAndInventoryTab, "OneHit All Resources", "Mine any resources with one hit")
local CollectAllArtifacts = AtlasHub.Toggle:Create(MineAndInventoryTab, "Show Collect All Artifacts Button", "Show a button in more tab that auto collect all artifacts from local planet")
local ArtifactTp = AtlasHub.Button:Create(MineAndInventoryTab,"Teleport to random Artifact")
local CollectAllGems = AtlasHub.Toggle:Create(MineAndInventoryTab, "Show Collect All Gems Button", "Show a button in more tab that auto collect all gems from local planet")
local AlwaysEquipParachute = AtlasHub.Toggle:Create(MineAndInventoryTab, "Always Equip Parachute (Fun)", "Always equip your parachute, also work while sitting in ship")
local RobloxInventory = AtlasHub.Toggle:Create(MineAndInventoryTab, "Roblox Inventory", "Use roblox original inventory instead of in game inventory")


OneHitResources.Changed:Connect(function(Value)
	OneHitResourcesV.Value = Value
end)

CollectAllArtifacts.Changed:Connect(function(Value)
	CollectAllLocalPlanetArtifactValue.Value = Value
end)

CollectAllGems.Changed:Connect(function(Value)
	CollectAllLocalPlanetGemValue.Value = Value
end)

AlwaysEquipParachute.Changed:Connect(function(Value)
	AlwaysEquipParachuteV.Value = Value
end)

RobloxInventory.Changed:Connect(function(Value)
	OldInventoryV.Value = Value
end)

ArtifactTp.Clicked:Connect(function()
	MineAndInventory.ArtifactTp(LocalPlayer.Character)
end)

------------------------------------------------------------------------------------------------------------------------------------------------------------

----- Drill Tab -------------------

local ForwardSpeed = AtlasHub.TextBox:Create(DrillTab, "Drill Forward Speed", "Enter Drill Forward Speed amount...")
local RetractSpeed = AtlasHub.TextBox:Create(DrillTab, "Drill Retract Speed", "Enter Drill Retract Speed amount...")
local DetectionRange = AtlasHub.TextBox:Create(DrillTab, "Drill Detection Range", "Enter Drill Detection Range amount...")
local ExtractBtn = AtlasHub.Button:Create(DrillTab,"End the drill mini-game")

ForwardSpeed.Submitted:Connect(function(Text)
	local v = tonumber(Text) or 0
	if not v or v < 10 or v > 250 then ShowNotify("Value must be at least 20 and no more than 250, resetting Forward Speed...", 3); v = 45 end
	DrillConfi.SetForwardSpeed(v)
end)

RetractSpeed.Submitted:Connect(function(Text)
	local v = tonumber(Text) or 0
	if not v or v < 10 or v > 250 then ShowNotify("Value must be at least 10 and no more than 250, resetting Retract Speed...", 3); v = 123 end
	DrillConfi.SetRetractSpeed(v)
end)

DetectionRange.Submitted:Connect(function(Text)
	local v = tonumber(Text) or 0
	if not v or v < 1 or v > 6000 then ShowNotify("Value must be at least 1 and no more than 6000, resetting Detection Range...", 3); v = 8 end
	DrillConfi.SetDetectionRange(v)
end)

ExtractBtn.Clicked:Connect(function()
	DrillConfi.Extract()
end)

-----------------------------------------------------------------

AtlasHub:Notify(
	"Successfully loaded Atlas Hub!",
	3
)
