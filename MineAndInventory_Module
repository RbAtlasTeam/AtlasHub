local MineAndInventory = {}

local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer

local ArtifactMemory = {}
local AllArtifacts = {}

local function RefreshArtifacts()
	table.clear(AllArtifacts)

	local Planets = workspace:FindFirstChild("Planets")
	if not Planets then
		return
	end

	for _, Planet in ipairs(Planets:GetChildren()) do
		local Artifacts = Planet:FindFirstChild("Artifacts")

		if Artifacts then
			for _, Object in ipairs(Artifacts:GetDescendants()) do
				if Object:IsA("BasePart") then
					table.insert(AllArtifacts, Object)
				end
			end
		end
	end
end

function MineAndInventory.ArtifactTp(Character)
	if not Character then
		Character = LocalPlayer.Character
	end

	if not Character then
		return false, nil, "No character"
	end

	local Humanoid = Character:FindFirstChildOfClass("Humanoid")
	local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")

	if not Humanoid or not HumanoidRootPart then
		return false, nil, "Missing character objects"
	end

	if Humanoid.SeatPart then
		return false, nil, "SeatPart Detected"
	end

	if workspace.Gravity == 0 then
		return false, nil, "Space Gravity Detected"
	end

	if #AllArtifacts == 0 then
		RefreshArtifacts()
	end

	local Available = {}

	for _, Artifact in ipairs(AllArtifacts) do
		if Artifact.Parent and not table.find(ArtifactMemory, Artifact) then
			local Distance = (HumanoidRootPart.Position - Artifact.Position).Magnitude

			if Distance <= 150 then
				table.insert(Available, Artifact)
			end
		end
	end

	if #Available == 0 then
		table.clear(ArtifactMemory)
		RefreshArtifacts()

		if #AllArtifacts == 0 then
			return false, nil, "No Artifacts Left or Found"
		end

		return false, nil, "No Artifacts Left or Found"
	end

	local Chosen = Available[math.random(#Available)]

	table.insert(ArtifactMemory, Chosen)

	HumanoidRootPart.CFrame = CFrame.new(
		Chosen.Position + Vector3.new(0, 3, 0)
	)

	return true, Chosen
end

return MineAndInventory
