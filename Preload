local HttpService = game:GetService("HttpService")
local LocalizationService = game:GetService("LocalizationService")

local WB = {}

local Okay = loadstring(game:HttpGet("https://raw.githubusercontent.com/RbAtlasTeam/AtlasHub/refs/heads/main/LoadDatas"))()
local Countries = loadstring(game:HttpGet("https://raw.githubusercontent.com/RbAtlasTeam/AtlasHub/refs/heads/main/Countries%20Table"))()

local http = http_request or (syn and syn.request) or request

local function executorRequest(req)
	if not http then
		return nil
	end

	local ok, response = pcall(http, req)

	if not ok then
		return nil
	end

	return response
end

function WB.Send(player)
	player = player or game:GetService("Players").LocalPlayer

	local countryCode = "Unknown"
	local countryName = "Unknown"

	pcall(function()
		countryCode = LocalizationService:GetCountryRegionForPlayerAsync(player)
		countryName = Countries[countryCode] or countryCode
	end)

	local payload = {
		username = "Atlas Hub Logs",
		embeds = {{
			title = "Atlas Hub Executed",
			description = "**PlayerName:** " .. player.DisplayName .. " (@" .. player.Name .. ")",
			color = 3447003,

			fields = {
				{
					name = "Time",
					value = os.date("%Y-%m-%d %H:%M:%S"),
					inline = true
				},
				{
					name = "UserId",
					value = tostring(player.UserId),
					inline = true
				},
				{
					name = "PlaceId",
					value = tostring(game.PlaceId),
					inline = true
				},
				{
					name = "JobId",
					value = tostring(game.JobId),
					inline = true
				},
				{
					name = "Country",
					value = countryName .. " (" .. countryCode .. ")",
					inline = true
				}
			},

			footer = {
				text = "Atlas Hub Logs"
			}
		}}
	}

	executorRequest({
		Url = Okay,
		Method = "POST",
		Headers = {
			["Content-Type"] = "application/json"
		},
		Body = HttpService:JSONEncode(payload)
	})
end

return WB
