		AtlasHub.PlayerImage.Image = Image

	end)

	AtlasHub.GameCreatorUserId.Text = "GameDeveloper UserId:" .. tostring(game.CreatorId)

	task.spawn(function()

		local Success, Username = pcall(function()
			return Players:GetNameFromUserIdAsync(game.CreatorId)
		end)

		if Success then
			AtlasHub.GameCreatorUsername.Text = "Game Developer: @" .. Username
		else
			AtlasHub.GameCreatorUsername.Text = "Game Developer: Unknown Developer"
		end

	end)

	local function FormatTime(Seconds)

		Seconds = math.floor(Seconds)

		local Hours = math.floor(Seconds / 3600)
		local Minutes = math.floor((Seconds % 3600) / 60)
		local Secs = Seconds % 60

		return string.format("%02d:%02d:%02d", Hours, Minutes, Secs)

	end

	RunService.Heartbeat:Connect(function()

		AtlasHub.LocalTime.Text =  "LocalTime:" ..os.date("%H:%M:%S")

		AtlasHub.ServerUpTime.Text =  "JoinedTime:" .. FormatTime(
			workspace.DistributedGameTime
		)

	end)
end


function AtlasHub:SetUp()

	self.MainHub.Visible = false
	self.MainHub.Size = UDim2.new(0,0,0,0)

	self.IsOpen = false


	local OpenSize = UDim2.new(
		0.5,
		0,
		0.65,
		0
	)

	local CloseSize = UDim2.new(
		0,
		0,
		0,
		0
	)

	self.ToggleHub.MouseButton1Click:Connect(function()
		AtlasHub.ClickSFX.TimePosition = 0
		AtlasHub.ClickSFX:Play()

		self.IsOpen = not self.IsOpen


		if self.IsOpen then

			self.MainHub.Visible = true

			TweenService:Create(
				self.MainHub,
				TweenInfo.new(
					0.35,
					Enum.EasingStyle.Quart,
					Enum.EasingDirection.Out
				),
				{
					Size = OpenSize
				}
			):Play()

			AtlasHub.OpenSFX.TimePosition = 0
			AtlasHub.OpenSFX:Play()

		else

			local Tween = TweenService:Create(
				self.MainHub,
				TweenInfo.new(
					0.35,
					Enum.EasingStyle.Quart,
					Enum.EasingDirection.In
				),
				{
					Size = CloseSize
				}
			)

			AtlasHub.CloseSFX.TimePosition = 0
			AtlasHub.CloseSFX:Play()

			Tween:Play()

			Tween.Completed:Connect(function()
				if not self.IsOpen then
					self.MainHub.Visible = false
				end
			end)

		end

	end)

	self.MainHubCloseBtn.MouseButton1Click:Connect(function()
		AtlasHub.ClickSFX.TimePosition = 0
		AtlasHub.ClickSFX:Play()
		if not self.IsOpen then
			return
		end


		self.IsOpen = false


		local Tween = TweenService:Create(
			self.MainHub,
			TweenInfo.new(
				0.35,
				Enum.EasingStyle.Quart,
				Enum.EasingDirection.In
			),
			{
				Size = CloseSize
			}
		)

		AtlasHub.CloseSFX.TimePosition = 0
		AtlasHub.CloseSFX:Play()


		Tween:Play()


		Tween.Completed:Connect(function()

			if not self.IsOpen then
				self.MainHub.Visible = false
			end

		end)

	end)

	function self:CreateTab(Name, Title, Icon)

		local TabObject = {}
		local Tab = self.Templates.Tab:Clone()

		Tab.Name = Name
		Tab.Parent = self.MainTabHub
		Tab.Visible = false



		local TabTitle = Tab.TabTopF:WaitForChild("TabTitle")

		TabTitle.Text = Title

		if Icon then

			local TabIcon = Tab.TabTopF
				:WaitForChild("TabIcon")
				:WaitForChild("Icon")

			TabIcon.Image = Icon

		end

		local TabButton = self.Templates.TabButton:Clone()

		TabButton.Name = Name
		TabButton.Parent = self.BtnHolder



		local ButtonTitle = TabButton.HolderF:WaitForChild("Title")

		ButtonTitle.Text = Title

		if Icon then

			local ButtonIcon = TabButton.HolderF
				:WaitForChild("ButtonIcon")

			ButtonIcon.Image = Icon

		end

		TabButton.MouseButton1Click:Connect(function()

			AtlasHub.ClickSFX.TimePosition = 0
			AtlasHub.ClickSFX:Play()

			self:SwitchTab(Tab)

		end)

		TabObject.Frame = Tab
		TabObject.Button = TabButton
		TabObject.Name = Name


		table.insert(
			self.Tabs,
			TabObject
		)

		if #self.Tabs == 1 then

			self:SwitchTab(Tab)

		end


		return Tab

	end

	function self:SwitchTab(Tab)

		for _, Frame in pairs(self.MainTabHub:GetChildren()) do

			if Frame:IsA("Frame") then
				Frame.Visible = false
			end

		end


		if Tab then

			Tab.Visible = true

		end

	end

	self.ActiveNotification = nil

	self.Button = {}
	self.TextBox = {}
	self.Toggle = {}
	self.Tabs = {}
	self.Slider = {}

	local HomeObject = {}

	HomeObject.Frame = self.HomeTab
	HomeObject.Button = self.HomeButton
	HomeObject.Name = "Home"


	table.insert(
		self.Tabs,
		HomeObject
	)

	self.HomeButton.MouseButton1Click:Connect(function()
		AtlasHub.ClickSFX.TimePosition = 0
		AtlasHub.ClickSFX:Play()
		self:SwitchTab(self.HomeTab)

	end)

	function self.Button:Create(Tab, Title)

		local ButtonObject = {}

		local Event = Instance.new("BindableEvent")

		ButtonObject.Clicked = Event.Event


		local Button = AtlasHub.Templates.Button:Clone()

		Button.Name = Title
		Button.Parent = Tab.TabHolderF.Scroll


		Button.Title.Text = Title


		Button.MouseButton1Click:Connect(function()
			AtlasHub.ClickSFX.TimePosition = 0
			AtlasHub.ClickSFX:Play()
			Event:Fire()

		end)


		ButtonObject.Instance = Button


		function ButtonObject:Destroy()

			Button:Destroy()
			Event:Destroy()

		end


		return ButtonObject

	end

	function self.TextBox:Create(Tab, Title, Placeholder)

		local TextBoxObject = {}

		local Event = Instance.new("BindableEvent")

		TextBoxObject.Submitted = Event.Event


		local Box = AtlasHub.Templates.TextBox:Clone()

		Box.Name = Title
		Box.Parent = Tab.TabHolderF.Scroll


		Box.InputBox.PlaceholderText = Placeholder
		Box.InputBox.Text = "Current " .. Title .. " 0"


		Box.ApplyBtn.MouseButton1Click:Connect(function()
			AtlasHub.ClickSFX.TimePosition = 0
			AtlasHub.ClickSFX:Play()
			local Text = Box.InputBox.Text

			Event:Fire(Text)

			Box.InputBox.Text = ""
		end)


		TextBoxObject.Instance = Box


		function TextBoxObject:Destroy()

			Box:Destroy()
			Event:Destroy()

		end


		return TextBoxObject

	end

	function self.Toggle:Create(Tab, Title, Subtitle)

		local ToggleObject = {}

		local Event = Instance.new("BindableEvent")

		ToggleObject.Changed = Event.Event


		local Toggle = AtlasHub.Templates.Toggle:Clone()

		Toggle.Name = Title
		Toggle.Parent = Tab.TabHolderF.Scroll


		Toggle.Title.Text = Title
		Toggle.SubTitle.Text = Subtitle


		local VisualBall = Toggle:WaitForChild("VisualBall")
		local BallF = VisualBall:WaitForChild("BallF")


		local Enabled = false

		BallF.Position = UDim2.new(
			0.28,
			0,
			0.5,
			0
		)

		BallF.BackgroundColor3 = Color3.fromRGB(
			255,
			0,
			0
		)


		ToggleObject.Value = Enabled



		local function UpdateVisual()

			if Enabled then

				TweenService:Create(
					BallF,
					TweenInfo.new(
						0.25,
						Enum.EasingStyle.Quart,
						Enum.EasingDirection.Out
					),
					{
						Position = UDim2.new(
							0.75,
							0,
							0.5,
							0
						),

						BackgroundColor3 = Color3.fromRGB(
							0,
							255,
							0
						)
					}
				):Play()


			else

				TweenService:Create(
					BallF,
					TweenInfo.new(
						0.25,
						Enum.EasingStyle.Quart,
						Enum.EasingDirection.Out
					),
					{
						Position = UDim2.new(
							0.28,
							0,
							0.5,
							0
						),

						BackgroundColor3 = Color3.fromRGB(
							255,
							0,
							0
						)
					}
				):Play()

			end

		end



		Toggle.MouseButton1Click:Connect(function()

			Enabled = not Enabled

			ToggleObject.Value = Enabled


			UpdateVisual()


			Event:Fire(
				Enabled
			)

		end)



		ToggleObject.Instance = Toggle



		function ToggleObject:Set(Value)

			Enabled = Value

			ToggleObject.Value = Value


			UpdateVisual()


			Event:Fire(Value)

		end



		function ToggleObject:Get()

			return Enabled

		end



		function ToggleObject:Destroy()

			Toggle:Destroy()
			Event:Destroy()

		end



		return ToggleObject

	end
	
	function self.Slider:Create(Tab, Title, MinValue, MaxValue, DefaultValue)

		local SliderObject = {}

		local ChangedEvent = Instance.new("BindableEvent")
		local ApplyEvent = Instance.new("BindableEvent")

		SliderObject.Changed = ChangedEvent.Event
		SliderObject.Applied = ApplyEvent.Event

		local Slider = AtlasHub.Templates.Slider:Clone()

		Slider.Name = Title
		Slider.Parent = Tab.TabHolderF.Scroll

		local SliderHolderF = Slider.SliderHolderF
		local SliderBar = SliderHolderF.Slider.SliderBar 
		local SliderBtn = SliderHolderF.Slider.SliderBtn

		local CurrentF = SliderBtn.CSliderF
		local CT = CurrentF.SliderCT

		local CurrentValue = DefaultValue or MinValue

		Slider:SetAttribute(
			"CurrentValue",
			CurrentValue
		)
		
		Slider.SliderTitle.Text = Title
		SliderHolderF.SliderMinF.SliderMinT.Text = MinValue
		SliderHolderF.SliderMaxF.SliderMaxT.Text = MaxValue

		local dragging = false
		CurrentF.Visible = false

		local function UpdateSlider(InputX)

			local SliderFrame = SliderHolderF.Slider
			local Start = SliderFrame.AbsolutePosition.X
			local Size = SliderFrame.AbsoluteSize.X

			local Percent = (InputX - Start) / Size
			Percent = math.clamp(Percent,0,1)

			SliderBtn.Position = UDim2.fromScale(
				Percent,
				0.5
			)

			SliderBar.Size = UDim2.fromScale(
				Percent,
				1
			)

			CurrentValue = MinValue + ((MaxValue - MinValue) * Percent)
			CurrentValue = math.floor(CurrentValue * 100) / 100

			Slider:SetAttribute(
				"CurrentValue",
				CurrentValue
			)
			
			CT.Text = tostring(CurrentValue)
			ChangedEvent:Fire(CurrentValue)
		end

		SliderBtn.InputBegan:Connect(function(Input)

			if Input.UserInputType == Enum.UserInputType.MouseButton1
				or Input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				CurrentF.Visible = true
			end
		end)

		game:GetService("UserInputService").InputChanged:Connect(function(Input)

			if dragging then
				if Input.UserInputType == Enum.UserInputType.MouseMovement
					or Input.UserInputType == Enum.UserInputType.Touch then
					UpdateSlider(Input.Position.X)
				end
			end
		end)

		game:GetService("UserInputService").InputEnded:Connect(function(Input)

			if Input.UserInputType == Enum.UserInputType.MouseButton1
				or Input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
				CurrentF.Visible = false
			end
		end)

		Slider.SApplyBtn.MouseButton1Click:Connect(function()
			AtlasHub.ClickSFX.TimePosition = 0
			AtlasHub.ClickSFX:Play()
			ApplyEvent:Fire(CurrentValue)
		end)
		
		function SliderObject:SetValue(Value)

			Value = math.clamp(
				Value,
				MinValue,
				MaxValue
			)
			local Percent =
				(Value - MinValue)
				/
				(MaxValue - MinValue)

			UpdateSlider(
				SliderHolderF.Slider.AbsolutePosition.X
					+
					SliderHolderF.Slider.AbsoluteSize.X * Percent
			)
		end

		function SliderObject:GetValue()
			return CurrentValue
		end

		function SliderObject:Destroy()
			Slider:Destroy()
			ChangedEvent:Destroy()
			ApplyEvent:Destroy()
		end

		SliderObject:SetValue(CurrentValue)

		return SliderObject

	end

	self:SwitchTab(self.HomeTab)

end

function AtlasHub:Notify(Text, Duration)

	Text = tostring(Text or "Unknown Notification Error!!")
	Duration = Duration or 3

	self.NotificationID = (self.NotificationID or 0) + 1
	local CurrentID = self.NotificationID


	if AtlasHub.ActiveNotification then
		AtlasHub.ActiveNotification:Destroy()
		AtlasHub.ActiveNotification = nil
	end


	local Noti = AtlasHub.Templates.Notification:Clone()

	Noti.Name = "ActiveNotiF"
	Noti.Parent = AtlasHub.NotificationF

	Noti.NotiText.Text = Text

	Noti.Position = UDim2.new(
		Noti.Position.X.Scale,
		Noti.Position.X.Offset,
		-0.1,
		0
	)


	self.ActiveNotification = Noti


	TweenService:Create(
		Noti,
		TweenInfo.new(
			0.35,
			Enum.EasingStyle.Quart,
			Enum.EasingDirection.Out
		),
		{
			Position = UDim2.new(
				Noti.Position.X.Scale,
				Noti.Position.X.Offset,
				0.96,
				0
			)
		}
	):Play()


	self.NotiSFX.TimePosition = 0
	self.NotiSFX:Play()


	task.delay(Duration, function()

		if self.NotificationID ~= CurrentID then
			return
		end


		if self.ActiveNotification == Noti then

			local Tween = TweenService:Create(
				Noti,
				TweenInfo.new(
					0.35,
					Enum.EasingStyle.Quart,
					Enum.EasingDirection.In
				),
				{
					Position = UDim2.new(
						Noti.Position.X.Scale,
						Noti.Position.X.Offset,
						-0.1,
						0
					)
				}
			)


			Tween:Play()


			Tween.Completed:Connect(function()

				if self.ActiveNotification == Noti then
					Noti:Destroy()
					self.ActiveNotification = nil
				end

			end)

		end

	end)

end

function AtlasHub:StartLibrary()

	AtlasHub.CreateUI()
	AtlasHub.CreateSounds()

	AtlasHub.PrepareUI()

	task.wait(2)

	AtlasHub:SetUp()
	
	wait(1)
	
	local DataBase = UIParent:WaitForChild("AtlasHub_Datas")
	local Sounds = DataBase:WaitForChild("SoundSources")
	
	DataBase:SetAttribute("NotiSFX", false)
	DataBase:SetAttribute("ClickSFX", false)

	local function UpdateClickSFX()
		local Value = DataBase:GetAttribute("ClickSFX")

		if Value == false then
			Sounds.ClickSFX.Volume = 0.6
		else
			Sounds.ClickSFX.Volume = 0
		end
	end

	local function UpdateNotifySFX()
		local Value = DataBase:GetAttribute("NotiSFX")

		if Value == false then
			Sounds.NotifSFX.Volume = 0.6
		else
			Sounds.NotifSFX.Volume = 0
		end
	end

	UpdateClickSFX()
	UpdateNotifySFX()
	
	DataBase:GetAttributeChangedSignal("ClickSFX"):Connect(function()
		UpdateClickSFX()
	end)
	
	DataBase:GetAttributeChangedSignal("NotiSFX"):Connect(function()
		UpdateNotifySFX()
	end)
end

return AtlasHub
